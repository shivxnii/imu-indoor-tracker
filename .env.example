# Copy to ".env" (same folder as this file) to change defaults. All optional.
# Dev server port
PORT=5173
# Set to 0 to serve plain HTTP in development. Phones block motion sensors on plain HTTP over Wi-Fi, so leave HTTPS on for phone tests.
HTTPS=1
# Base path for static hosting under a sub-path (GitHub Pages: /your-repo-name/). Leave "/" for Vercel, Netlify and Cloudflare Pages.
BASE=/
